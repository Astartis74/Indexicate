# Redis REST credentials: configure real values locally and in Vercel; never commit them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random server-side secret, at least 32 bytes. Rotate if disclosed.
RATE_LIMIT_HMAC_SECRET=

# Optional fixed-window overrides. Defaults: audit=12, sitemap=2, window=600 seconds.
RATE_LIMIT_AUDIT_MAX=12
RATE_LIMIT_SITEMAP_MAX=2
RATE_LIMIT_WINDOW_SECONDS=600
